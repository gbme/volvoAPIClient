# Beheerd door Ansible (waarden uit de vault). Ook gebruikt door volvo-authenticate.
VOLVO_CLIENT_ID={{ vault_volvo_client_id | to_json }}
VOLVO_CLIENT_SECRET={{ vault_volvo_client_secret | to_json }}
VOLVO_REDIRECT_URI={{ vault_volvo_redirect_uri | to_json }}
VOLVO_VCC_API_KEY={{ vault_volvo_vcc_api_key | to_json }}
VOLVO_VIN={{ vault_volvo_vin | default('') | to_json }}
VOLVO_MQTT_API_URL={{ mqtt_api_url | to_json }}
VOLVO_MQTT_USER={{ vault_volvo_mqtt_user | to_json }}
VOLVO_MQTT_PASSWORD={{ vault_volvo_mqtt_password | to_json }}
VOLVO_TOKENS_FILE={{ app_tokens | to_json }}
VOLVO_LOG_DIR={{ log_dir | to_json }}
